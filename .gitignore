# Зависимости и результаты сборки
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo

# Секреты: в репозитории их нет. .env.example остаётся в репозитории.
.env
.env.local
.env.*.local

# Playwright
playwright-report/
test-results/
blob-report/
.playwright/
e2e/.auth/

# Логи
*.log
npm-debug.log*

# Редакторы и ОС
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Каталог локального хранилища: файлы пользователей, в репозитории им не место.
storage/
.local-storage/

# Страховка от дефекта: если настройка пути окажется пустой, файлы падают в корень проекта
# (storage.service.ts подставлял '' — это текущий каталог). Правило ловит объекты хранилища по
# имени: ключ объекта — UUID, расширение — исходное. Сам дефект исправлен отдельно, правило
# оставлено, чтобы промах не попал в репозиторий молча.
/*[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*
