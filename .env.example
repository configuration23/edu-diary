# Пример переменных окружения edu-diary.
#
# Значения ниже — намеренно неправдоподобные примеры: приложение распознаёт их
# и отказывается стартовать, если секрет остался равен примеру (SECURITY.md §3.2).
# Рабочий .env создаётся командой:  npm run bootstrap:env

# ── Обязательные секреты ─────────────────────────────────────────────────────
# Без них приложение не поднимается: проверка выполняется при старте.

# Строка подключения PostgreSQL. Допустимы только схемы postgres:// и postgresql://.
DATABASE_URL=postgres://edu_diary:change-me-postgres-password@localhost:5432/edu_diary

# Секрет для подписи сессий, минимум 32 символа.
SESSION_SECRET=change-me-session-secret-with-more-than-32-characters

# Ключ шифрования секретов в БД: ровно 32 байта в base64 или 64 hex-символа.
STORAGE_ENCRYPTION_KEY=change-me-storage-encryption-key-32-bytes=

# ── Приложение ──────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true — читаемые логи (по умолчанию включено вне production)
LOG_PRETTY=true

# ── Docker Compose ──────────────────────────────────────────────────────────
# Пароль базы должен быть безопасным для URL: без @ : / # ?
POSTGRES_USER=edu_diary
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=edu_diary
# Адрес, который обслуживает Caddy.
#   :8080                        — HTTP, любой хост (удобно для проверки по IP стенда);
#   http://localhost:8080        — HTTP, только при заходе на localhost;
#   diary.example.ru             — HTTPS с автоматическим сертификатом (прод).
# При домене для HTTPS запускайте стек с -f docker-compose.prod.yml.
SITE_ADDRESS=:8080
# Порт, который публикует Caddy. Должен совпадать с портом в SITE_ADDRESS.
HTTP_PORT=8080

# ── Тесты ───────────────────────────────────────────────────────────────────
# Нужен интеграционным тестам и e2e; без него эти тесты пропускаются.
# Должен указывать на отдельную базу: тесты применяют миграции.
TEST_DATABASE_URL=postgres://edu_diary:change-me-postgres-password@localhost:5432/edu_diary_test
