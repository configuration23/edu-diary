# Caddy: HTTPS и маршрутизация.
#
# Локально:  SITE_ADDRESS=http://localhost:8080 — обычный HTTP без сертификата.
# На сервере: SITE_ADDRESS=diary.example.ru  — Caddy сам получит сертификат
#             Let's Encrypt и будет слушать 80/443 (см. docker-compose.prod.yml).
#
# Чтобы получать письма об истечении сертификата, добавьте в глобальный блок
# ниже строку: email you@example.ru

{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-X-Powered-By
		-Server

		# Кликджекинг: чужой сайт не может встроить дневник в iframe и подменить действия.
		X-Frame-Options "DENY"

		# Строгая CSP: только свои скрипты и стили. Встроенный скрипт темы вынесен в
		# /theme-init.js именно поэтому — иначе понадобился бы 'unsafe-inline'.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"

		# Лишние возможности браузера не нужны: камера, микрофон, геолокация, платежи.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}

	# Карты сборки не отдаём, даже если они остались от прошлой версии.
	@maps path *.map
	respond @maps 404

	# API обслуживает Fastify.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Всё остальное — статика React.
	handle {
		reverse_proxy web:80
	}

	log {
		output stdout
		format json
	}
}
